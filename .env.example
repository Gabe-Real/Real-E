# All lists should be inline, separated by commas and optionally whitespace.

# Discord bot token
TOKEN=
# The client id, also known as the user id of the bot
CLIENT_ID=
# The id of the guild you test the bot in
TESTING_GUILD_ID=
# Whether the bot should deploy commands globally (true/false)
DEPLOY_GLOBAL=
# A link to a MongoDB database
MONGODB_URI=

# Twitch app for live alerts (optional) - create one at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
